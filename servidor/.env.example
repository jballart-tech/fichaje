# Copia este archivo como .env y rellena los valores.
# Genera los secretos con: node herramientas/admin.js generar-secretos

PUERTO=3100
# Proxies delante del servidor (IIS, Cloudflare...). 1 si usas IIS como proxy inverso.
PROXIES=1

JWT_SECRETO=
# Clave que usará Nexa Hub en la cabecera X-Admin-Clave.
ADMIN_CLAVE=
SESION_DIAS=90

# SQL Server de Nexa Hub. Usa un usuario SQL propio con permisos solo sobre el esquema fichaje.
BD_SERVIDOR=localhost
# Deja BD_PUERTO vacío si usas instancia con nombre (por ejemplo SQLEXPRESS).
BD_PUERTO=1433
BD_INSTANCIA=
BD_NOMBRE=NexaHub
BD_USUARIO=fichaje_app
BD_CLAVE=
BD_CIFRAR=true
BD_CONFIAR_CERTIFICADO=true

# Hora que manda el móvil: segundos de adelanto tolerados y horas máximas de retraso sin aviso.
MARGEN_FUTURO_SEG=120
MAX_ANTIGUEDAD_HORAS=72
